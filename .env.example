# Copy this file to .env and replace placeholders with local values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
# Local default. Use PostgreSQL in deployment, for example:
# DB_URL=postgresql://jarvis:password@localhost:5432/jarvis
DB_URL=sqlite:///db.sqlite3